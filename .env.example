# Copy to .env and fill in real values before `docker compose up --build`

MONGODB_DB_NAME=Clip_AI
# Compose overrides MONGODB_URI / REDIS_URL to use the mongo + redis services.
# To use Atlas instead, set MONGODB_URI here and remove the MONGODB_URI override
# from docker-compose.yml for backend and worker.

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=

PEXELS_API_KEY=
PIXABAY_API_KEY=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DEFAULT_CLIP_DURATION_SECONDS=60
DEFAULT_AD_DURATION_SECONDS=10
AD_CLIP_PATH=
MAX_UPLOAD_SIZE_BYTES=5368709120

# Legacy summary generation (unused for Instagram captions)
OPENAI_API_KEY=
GEMINI_API_KEY=
SUMMARY_SAMPLE_SECONDS=300
SUMMARY_SEGMENT_SECONDS=60
SUMMARY_MAX_SEGMENTS=5
# Ready-made Instagram captions from Clippers (no auth)
COPY_POOL_BASE_URL=https://clippers.globalgossip.info
COPY_POOL_API_KEY=
INSTAGRAM_PUBLISH_DELAY_SECONDS=30

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=http://localhost:8000

# Razorhost FTP (clip storage)
FTP_HOST=ftp.purplemerit.shop
FTP_PORT=21
FTP_USER=clips@purplemerit.shop
FTP_PASSWORD=
FTP_REMOTE_DIR=/
FTP_PUBLIC_BASE_URL=https://purplemerit.shop/clips

