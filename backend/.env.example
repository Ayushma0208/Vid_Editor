# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/clipai
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/clipai

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
SECRET_KEY=your-random-secret-key-here

# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# B-Roll
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Storage (leave as local for dev)
STORAGE_TYPE=local
LOCAL_MEDIA_PATH=./media

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]
